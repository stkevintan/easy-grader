{
  "name": "easy-grader-server",
  "version": "0.2.4",
  "private": true,
  "description": "Easy Grader 服务端：账号、额度、兑换码、AI 评分、适配预设、管理后台静态托管",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=.env dist/main.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "bench": "node scripts/bench.mjs",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "11.0.3",
    "better-sqlite3": "12.11.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  }
}
