# 复制为 .env 后按需修改
PORT=3000
HOST=127.0.0.1

# SQLite 文件路径（相对 server/ 目录）
DB_PATH=data/app.db

# JWT 签名密钥：生产环境必须设置为足够长的随机串（openssl rand -hex 32）
JWT_SECRET=
JWT_EXPIRES_IN=7d

# 是否开放注册、新用户赠送的评分次数
ALLOW_REGISTER=true
INITIAL_CREDITS=20

# 启动时若不存在则自动创建的管理员账号
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# OpenAI 兼容的视觉模型。MODEL_API_KEY 为空时使用 mock 评分（只用于联调）
# 例：通义  https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-vl-max
#     豆包  https://ark.cn-beijing.volces.com/api/v3            <你的推理接入点 ID>
#     vLLM  http://127.0.0.1:8000/v1                            <served model name>
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_MS=60000
MODEL_TEMPERATURE=0.1
# 单次回复的最大输出 token。推理模型会先花一部分在思考上，太小会导致正文为空
MODEL_MAX_TOKENS=8000
# 推理模型的思考强度：none / minimal / low / medium / high，默认 low（none 最快）
# 设为 off 表示不传该参数（模型不认识它时用，服务商会用默认强度，通常更慢）
MODEL_REASONING_EFFORT=low
# 上游 5xx / 429 / 连接失败 / 超时时的重试次数（不含首次请求）与首次等待毫秒数（之后翻倍）
MODEL_MAX_RETRIES=2
MODEL_RETRY_DELAY_MS=800

# 两阶段评分：第一次只转录（提示词里没有题目和评分标准），第二次拿固定文字 + 评分标准打分。
# 可以显著减少模型按得分点“脑补”答卷文字；代价是每次评分多一次模型调用。
OCR_TWO_PASS=true
# 评分阶段是否重新把图片发给模型。false 表示只按转录文字打分，从机制上杜绝重新读图编造
SCORE_WITH_IMAGE=true
# 评分阶段并行采样次数，取中位数：1 只调用一次；3 可明显压低随机波动，成本约 3 倍 token
MODEL_SAMPLE_COUNT=1
# 额外的模型方案（JSON），由功能开关 model_profile 按用户/单位/比例选择，用于灰度新模型或新参数。
# 每个方案只写要覆盖的字段，其余沿用上面的 MODEL_*。例：
# MODEL_PROFILES={"qwen-max":{"name":"qwen-vl-max","sampleCount":3},"fast":{"reasoningEffort":"none"}}
MODEL_PROFILES=

# 单张答卷图片上限（字节）
MAX_IMAGE_BYTES=4194304

# 保存评分 trace：每次调模型后把题目、答卷图片、提示词、原始输出（含思考过程）写到 TRACE_DIR
# 用于离线评测；包含学生答卷，只在本地保存，不要上传或提交
SAVE_TRACES=false
TRACE_DIR=data/traces

# 自动学习：把老师人工确认过的历史成绩作为评分示例写进提示词，校准本题的评分尺度
# 只取 autoSubmitted=false 的记录；示例里含其他学生的作答文字，和答卷图片一样会发给模型服务商
GOLD_ENABLED=false
# 每次最多带几个示例（按分数段轮转挑选，避免只出现高分）
GOLD_MAX_EXAMPLES=4

# 额外允许跨域的来源（逗号分隔）。chrome-extension:// 默认允许
CORS_ORIGINS=

# 是否提供 /demo/ 演示阅卷页、启动时是否写入演示页的适配预设（Docker 镜像里默认都关闭）
SERVE_DEMO=true
SEED_DEMO_PRESET=true

# 管理后台 / 演示页静态文件目录；留空则在仓库根目录查找（Docker 镜像里已设好）
ADMIN_DIR=
DEMO_DIR=

# 限流（每分钟）
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=10
RATE_LIMIT_JUDGE=30
